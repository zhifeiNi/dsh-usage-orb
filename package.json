{
    "name": "dsh-usage-orb",
    "version": "0.2.2",
    "private": true,
    "description": "DSH 浮动面板：跨会话用量统计（事件流逐请求口径、缓存经济性、峰谷成本、工具与压缩诊断）",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=22.19"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [
                "@deepseek-ai/dsh-client-runtime",
                "@deepseek-ai/dsh-client-ui-slots"
            ],
            "platform": "web"
        }
    },
    "files": [
        "lib/",
        "cordis.patch.yml",
        "README.md",
        "LICENSE",
        "THIRD-PARTY-NOTICES.md",
        "CHANGELOG.md"
    ],
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.1",
        "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6 || ^0.2.0-rc.2",
        "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6 || ^0.2.0-rc.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "license": "MIT",
    "scripts": {
        "test": "node test/unit.mjs && node test/balance.mjs && node test/client-pure.mjs",
        "test:e2e": "node test/e2e.mjs"
    },
    "author": "zhifeiNi",
    "keywords": [
        "dsh",
        "dsh-plugin",
        "deepseek-harness",
        "usage",
        "token",
        "dashboard",
        "electron"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zhifeiNi/dsh-usage-orb.git"
    },
    "homepage": "https://github.com/zhifeiNi/dsh-usage-orb#readme",
    "bugs": {
        "url": "https://github.com/zhifeiNi/dsh-usage-orb/issues"
    }
}
